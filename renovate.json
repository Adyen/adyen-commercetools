{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": false,
  "minimumReleaseAge": "30 days",
  "schedule": [
    "every weekend"
  ],
  "groupName": "all",
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "description": "Dev tooling (test runners, linters, formatters) may automerge once a release has been public for 30 days; everything else needs a human review.",
      "matchDepTypes": [
        "devDependencies"
      ],
      "groupName": "dev-dependencies",
      "automerge": true,
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "Keep container base images pinned to an immutable digest (the tag alone is mutable).",
      "matchManagers": [
        "dockerfile"
      ],
      "pinDigests": true
    }
  ]
}
